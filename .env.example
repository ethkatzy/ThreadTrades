# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Postgres (used by docker-compose.yml and backend/src/main/resources/application.yml)
DB_NAME=threadtrades
DB_USERNAME=threadtrades
DB_PASSWORD=changeme

# Backend
JWT_SECRET=changeme-generate-a-long-random-value
SERVER_PORT=8080

# Local disk storage path (dev-only default; see ROADMAP.md #1 for the object storage decision)
STORAGE_LOCAL_PATH=./data/uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
