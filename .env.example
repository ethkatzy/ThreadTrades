# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Postgres (used by docker-compose.yml and backend/src/main/resources/application.yml)
DB_NAME=threadtrades
DB_USERNAME=threadtrades
DB_PASSWORD=changeme
# "disable" for local Compose Postgres; set to "require" against a hosted
# provider (Neon, Supabase, ...) that mandates TLS.
DB_SSLMODE=disable

# Backend
JWT_SECRET=changeme-generate-a-long-random-value
SERVER_PORT=8080
# Session cookie flags (see ROADMAP.md #3). "false"/"Lax" work for local http
# dev since frontend+backend are both "localhost". Cross-site deployments
# (frontend/backend on different domains, e.g. Render) need COOKIE_SECURE=true
# and COOKIE_SAME_SITE=None -- SameSite=None requires Secure.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Storage (see ROADMAP.md #1). "local" writes to disk (dev-only, doesn't
# survive a redeploy) and needs only STORAGE_LOCAL_PATH below. "r2" uses
# Cloudflare R2 (or any S3-compatible endpoint) and needs the R2_* vars.
# Images are read back through the backend's own /media/{key} endpoint (see
# R2MediaController / ROADMAP.md #3), not R2's public URL directly -- no
# R2_PUBLIC_BASE_URL needed.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Origins allowed to call the backend via CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
# Where the frontend's own server reaches the backend to proxy /api/** through (see
# ROADMAP.md #3) -- server-side only, unlike NEXT_PUBLIC_API_URL above which the browser
# uses directly for images/WebSocket. In Docker Compose this is the backend service's
# container-network name, not localhost.
BACKEND_INTERNAL_URL=http://localhost:8080
